    {
      "dot": "amber",
      "title": "Restricciones de Integridad",
      "items": [
        "Restricciones UNIQUE en DNI, Email, Username, Teléfono y Código de Producto.",
        "Reglas CHECK en mayoría de edad (>= 18 años), stock no negativo y precios de venta."
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistencia Relacional",
      "items": [
