  "cards": [
    {
      "dot": "cyan",
      "title": "Presentation Layer & Desktop UX",
      "items": [
        "Framework: .NET 10 Windows Forms (net10.0-windows) running in SystemAware DPI mode.",
        "MaterialSkin.2 (v2.3.1): Enforces cohesive dark mode theming, MaterialForm base classes, and responsive tab drawers.",
        "FontAwesome.Sharp (v6.6.0): Provides vector iconography for navigation tabs, action buttons, and status indicators.",
        "LiveCharts (v0.9.7 / WinForms & Wpf): Renders interactive Cartesian and Pie analytics for manager and seller dashboards.",
        "Role-Based Access Control (RBAC): Dynamically filters drawer navigation and view permissions (Admin, Gerente, Vendedor)."
      ]
    },
    {
      "dot": "emerald",
      "title": "Business Logic & Domain Services",
      "items": [
        "Domain Workflows: SaleService coordinates multi-item POS sales, atomic stock deductions, and total calculations.",
        "Authentication & Security: UserService enforces SHA-256 password hashing and role validation against CurrentSession state.",
        "MailKit & MimeKit (v4.18.1): PasswordResetService dispatches 6-digit cryptographic OTP tokens over TLS (smtp.gmail.com:587).",
        "Thermal Ticket Generation: TicketReportService parses ticketSample.html to produce thermal POS receipt outputs.",
        "Audit & Governance: AuditService logs all sensitive events, user alterations, price modifications, and logins."
      ]
    },
    {
      "dot": "amber",
      "title": "Data Access & SQL Persistence",
      "items": [
        "Microsoft.Data.SqlClient (v7.0.2): Manages high-performance ADO.NET connection pooling and command executions.",
        "DatabaseConnection: Configures connection strings targeting (localdb)\\MSSQLLocalDB with TrustServerCertificate=True.",
        "DatabaseInitializer: Automated LocalDB provisioning on startup, restoring seed backups or executing DDL scripts.",
        "Stored Procedure Architecture: 100% of CRUD, filtering, and reporting is encapsulated in optimized T-SQL Stored Procedures.",
        "Table-Valued Parameters (TVP): SaleDal transmits complex shopping cart items to SQL Server in a single atomic transaction."
      ]
    },
    {
      "dot": "violet",
      "title": "Abstractions, Dependencies & Trust Boundaries",
      "items": [
        "3 Abstraction Tiers: Desktop Presentation (WinForms/MaterialSkin) -> Domain Logic (Services/Validation) -> Data Persistence (ADO.NET/SPs).",
        "Strict Dependency Flow: Presentation references BLL; BLL references DAL; DAL references Microsoft.Data.SqlClient; zero circular references.",
        "Client Trust Boundary: UI controls only hold in-memory session tokens (CurrentSession) and never query the database directly.",
        "Database Trust Boundary: SQL Server isolates business data behind stored procedures and parameterized commands, mitigating SQL injection.",
        "External Cloud Boundary: Encrypted SMTP relay communications isolate email delivery outside the local application network."
      ]
    }
  ]
}